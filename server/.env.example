FIREBASE_SERVICE_ACCOUNT_PATH=C:\path\to\firebase-service-account.json
FIREBASE_PROJECT_ID=attendance-monitoring-73028

# Required for signed, opaque student QR credentials. Keep this only on the server.
QR_SIGNING_SECRET=replace_with_a_long_random_secret
QR_CREDENTIAL_LIFETIME_MS=15552000000
ATTENDANCE_TIME_ZONE=Asia/Manila
ATTENDANCE_CUTOFF=07:30

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Twilio SMS configuration
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15551234567
# Optional: use this instead of TWILIO_PHONE_NUMBER when Twilio routes through a Messaging Service.
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Use simulated while testing without sending real SMS; change to live after upgrading Twilio.
SMS_MODE=live
SMS_PROVIDER=semaphore
SEMAPHORE_API_KEY=your_semaphore_api_key
SEMAPHORE_SENDER_NAME=LNHS